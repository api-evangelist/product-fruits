{
  "opencollection": "1.0.0",
  "info": {
    "name": "Product Fruits REST Events API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Track a custom event for a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.productfruits.com/v1/events/track",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Syncs a custom event from backend systems to a specified user. Custom properties in the properties object are available for future use in segmentation and targeting."
        }
      ]
    }
  ],
  "bundled": true
}